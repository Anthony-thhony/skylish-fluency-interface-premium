rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isTeacherEmail() {
      return signedIn()
        && request.auth.token.email == "biielcooperwinx@gmail.com";
    }

    function isTeacher() {
      return signedIn()
        && (
          isTeacherEmail()
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher"
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isTeacher();

      allow create: if isOwner(userId)
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.role == "student"
          || (request.resource.data.role == "teacher" && isTeacherEmail())
        );

      allow update: if isOwner(userId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role;

      allow delete: if false;

      match /progress/{lessonId} {
        allow read, write: if isOwner(userId);
        allow read: if isTeacher();
      }
    }

    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    match /comments/{lessonId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }
  }
}
